# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://helm:helm_dev_password@localhost:5432/helm

# ── Service Ports ────────────────────────────────────
API_PORT=3000
DICE_PORT=3001
VOICE_PORT=3002
VISION_PORT=3003
WEB_PORT=5173

# ── Auth (dev mode: any token accepted) ──────────────
AUTH_MODE=dev
DEV_TOKEN=helm-dev-token-2026

# ── Vision Service ───────────────────────────────────
VISION_MODEL_PATH=./models/unit_detector.tflite
CONFIDENCE_THRESHOLD=0.65
FINGERPRINT_EMBEDDING_DIM=128

# ── Voice Service ────────────────────────────────────
# Client-side STT via Web Speech API; server just parses intents
VOICE_CONFIDENCE_THRESHOLD=0.5
